# Copy this file to "secrets.properties" (same folder) for LOCAL builds in
# Android Studio. secrets.properties is gitignored and must never be
# committed. For CI builds (GitHub Actions), this file is generated
# automatically from the repo's encrypted Actions secrets instead — see
# .github/workflows/build-apk.yml.

GH_TOKEN=
GH_REPO=owner/repo-name
GH_BRANCH=main
# Leave blank to push to the repo's root ("main directory").
GH_SUBDIR=
